{
  "description": "Kasmos desktop with productivity apps and custom SSL certs.",
  "docker_registry": "https://ghcr.io",
  "image_src": "Kasmos.png",
  "run_config": {
    "hostname": "kasmos"
  },
  "exec_config": {
    "go": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --go --url \"$KASM_URL\"'"
    },
    "assign": {
      "cmd": "bash -c '/dockerstartup/custom_startup.sh --assign --url \"$KASM_URL\"'"
    }
  },
  "categories": [
    "Productivity",
    "Desktop"
  ],
  "friendly_name": "Kasmos Desktop",
  "architecture": [
    "amd64"
  ],
  "compatibility": [
    {
      "version": "1.16.x",
      "image": "ghcr.io/tidenetworksllc/kasm-kasmos-desktop:latest",
      "uncompressed_size_mb": 2400,
      "available_tags": [
        "latest"
      ]
    }
  ]
}
